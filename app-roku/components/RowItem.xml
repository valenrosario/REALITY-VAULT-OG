<?xml version="1.0" encoding="utf-8" ?>
<component name="RowItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="width" type="float" onChange="onSize" />
    <field id="height" type="float" onChange="onSize" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/RowItem.brs" />
  <script type="text/brightscript" uri="pkg:/source/Util.brs" />
  <children>
    <Rectangle id="bg" color="0x1A1518FF" />
    <Label id="ph" horizAlign="center" vertAlign="center" wrap="true" color="0xC6A3B3FF" />
    <Poster id="img" />
    <Poster id="shade" uri="pkg:/images/grad_fade.png" visible="false" />
    <Label id="num" color="0xF5A3C4FF" visible="false" vertAlign="bottom" horizAlign="right" />
    <Label id="tag" color="0xFFFFFFFF" visible="false" />
    <Rectangle id="progBg" color="0xFFFFFF55" visible="false" />
    <Rectangle id="prog" color="0xF5A3C4FF" visible="false" />
    <Label id="title" color="0xFDEEF4FF" maxLines="1" />
    <Label id="sub" color="0xC6A3B3FF" wrap="true" maxLines="2" />
  </children>
</component>
