{
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/ver/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/coleccion/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/serie/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/pelicula/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/series",
      "destination": "/index.html"
    },
    {
      "source": "/peliculas",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/mi-lista",
      "destination": "/index.html"
    },
    {
      "source": "/persona/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/activar",
      "destination": "/index.html"
    },
    {
      "source": "/tv",
      "destination": "/tv.html"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}